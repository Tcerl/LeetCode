<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record Rule: Users can only see THEIR OWN projects -->
    <record id="rule_custom_project_user" model="ir.rule">
        <field name="name">Custom Project: My Projects Only</field>
        <field name="model_id" ref="model_custom_project"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
    </record>

    <!-- Record Rule: Admins can see ALL projects -->
    <record id="rule_custom_project_manager" model="ir.rule">
        <field name="name">Custom Project: All Projects (Managers)</field>
        <field name="model_id" ref="model_custom_project"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
